<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.31.0</Version>
    <AssemblyName>CrucibleSuxLeveler</AssemblyName>
    <FileVersion>0.3.31.0</FileVersion>
    <Author>Michiru Tsukikage; pistolero-git (fork)</Author>
    <Name>Crucible SUX Leveler</Name>
    <Punchline>Crucible SUX fork with beast carry-leveling and direct rank/EXP tracking.</Punchline>
    <Description>Crucible SUX Leveler is a fork of Crucible SUX with a carry-leveling team mode and improved beast rank and EXP tracking. Uses AutoDuty to automate Crucible boards. Unattended automation is against the game terms of service.</Description>
    <RepoUrl>https://github.com/pistolero-git/CrucibleSux</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/pistolero-git/CrucibleSux/main/assets/icon.png</IconUrl>
    <Tags>beastmaster;crucible;tracker;planner</Tags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Michiru Tsukikage; fork changes by pistolero-git</Copyright>
    <RootNamespace>CrucibleSux</RootNamespace>
    <CrucibleSuxTestedGameVersion>2026.10.06.0000.0000</CrucibleSuxTestedGameVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TestedGameVersion" Value="$(CrucibleSuxTestedGameVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CrucibleSux.Core\CrucibleSux.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\assets\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\assets\icon.png')" />
  </ItemGroup>
</Project>
