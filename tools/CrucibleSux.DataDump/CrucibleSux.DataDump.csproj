<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline data-dump utility; not part of the distributed plugin.
    Use Dalamud's bundled Lumina so the sheet types match the plugin's runtime.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CrucibleSux.DataDump</RootNamespace>
    <!-- DALAMUD_HOME can override the per-platform default. Use portable / path separators. -->
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and '$(OS)' == 'Windows_NT'">$(AppData)/XIVLauncher/addon/Hooks/dev</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and '$(OS)' != 'Windows_NT'">$(HOME)/.xlcore/dalamud/Hooks/dev</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)/Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)/Lumina.Excel.dll" />
  </ItemGroup>
</Project>
